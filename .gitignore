.tmp-hermes-home/
# Generated per-build attestation (nonce + source fingerprint). Regenerated by
# scripts/gen-build-attestation.mjs before every packaged build and copied into
# the artifact via build.extraResources â€” it must never be committed.
build/build-attestation.json
build/release-manifest.json
build/release-report.json
build/pe-extract/
*.tsbuildinfo
*.log
.DS_Store

# Python bytecode
__pycache__/
.pytest_cache/
*.pyc

# Update-manifest signing key (in-app updater trust anchor). The PRIVATE half
# lives OUTSIDE the repository (%USERPROFILE%\.tachles-release\), which is the
# real control; these patterns are belt-and-braces in case someone ever runs
# `node scripts/gen-update-key.mjs --out <somewhere inside the tree>`. Leaking it
# would let an attacker sign an installer every installed app accepts as genuine.
.tachles-release/
*update-signing-key*.pem

# User-owned forensic captures live under docs/evidence/forensics/ and are
# deliberately NOT tracked (see "chore: untrack user-owned forensics capture").
# Without this rule they resurface as untracked noise and get swept into a
# release commit by an over-broad `git add`.
docs/evidence/forensics/
