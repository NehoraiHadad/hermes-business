{
  "name": "hermes-business",
  "version": "0.3.3",
  "private": true,
  "description": "A friendly always-available business assistant powered by Hermes Agent",
  "author": "העוזר לעסק (Alpha)",
  "main": "electron/main.cjs",
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "checksums": "node scripts/gen-installer-checksums.mjs",
    "gen:acceptance": "node scripts/gen-release-acceptance.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:plugin": "node scripts/build-plugin.mjs --check && node --check hermes-plugin/business-shell/plugin.js && node scripts/verify-plugin.mjs",
    "verify:bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bootstrap.ps1",
    "generate:icons": "python scripts/generate-icons.py",
    "install:plugin": "node scripts/build-plugin.mjs && node scripts/install-plugin.mjs",
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "node scripts/build-plugin.mjs && node scripts/verify-plugin.mjs && tsc -b && vite build",
    "build:qa": "node scripts/build-plugin.mjs && node scripts/verify-plugin.mjs && tsc -b && vite build --mode qa",
    "test": "vitest run",
    "test:plugin:policy": "python -m unittest discover -s hermes-plugin/business-whatsapp-policy/tests -p test_*.py -v",
    "test:e2e:hermes": "node scripts/e2e-hermes.mjs",
    "test:e2e:hermes-shared-state": "node scripts/e2e-hermes-shared-state.mjs",
    "test:e2e:whatsapp": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-whatsapp-onboarding.ps1",
    "test:e2e:installed-whatsapp-ui": "node scripts/e2e-installed-whatsapp-ui.mjs",
    "test:e2e:installed-attachment-ui": "node scripts/e2e-installed-attachment-ui.mjs",
    "test:e2e:installed-ui": "node scripts/e2e-installed-ui.mjs",
    "attest:test-packaged": "node scripts/gen-build-attestation.mjs",
    "build:test-packaged": "npm run build && node scripts/gen-build-attestation.mjs && electron-builder --win dir",
    "test:e2e:installed-isolated": "node scripts/e2e-installed-isolated.mjs",
    "test:e2e:installed-update": "node scripts/e2e-installed-update.mjs",
    "test:e2e:installed-partner-ui": "node scripts/e2e-installed-partner-ui.mjs",
    "test:e2e:bootstrap-clean": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-bootstrap-clean.ps1",
    "test:e2e:bootstrap-companion": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-companion-bootstrap.ps1",
    "test:e2e:thin-installer": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-thin-network-installer.ps1",
    "package:thin-installer:qa": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-thin-network-installer.ps1 -EmitQaArtifact",
    "test:e2e:missing-hermes-ui": "node scripts/e2e-missing-hermes-ui.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify:release": "npm test && npm run test:plugin:policy && npm run verify:plugin && npm run verify:bootstrap",
    "package:win": "npm run verify:release && npm run build && node scripts/gen-build-attestation.mjs && electron-builder --win nsis && node scripts/verify-no-update-metadata.mjs release",
    "package:win:qa": "npm run verify:release && npm run build:qa && node scripts/gen-build-attestation.mjs && electron-builder --win nsis && node scripts/verify-no-update-metadata.mjs release",
    "package:bootstrap": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-bootstrap.ps1"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.54.1",
    "rcedit": "^5.0.2",
    "rollup": "4.62.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "4.1.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.hermes.business",
    "productName": "העוזר לעסק",
    "asar": true,
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "hermes-plugin/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/build-attestation.json",
        "to": "build-attestation.json"
      },
      {
        "from": "installer/bootstrap.ps1",
        "to": "business-bootstrap/bootstrap.ps1"
      },
      {
        "from": "installer/bootstrap-companion.ps1",
        "to": "business-bootstrap/bootstrap-companion.ps1"
      },
      {
        "from": "hermes-plugin/business-shell/plugin.js",
        "to": "business-bootstrap/plugin.js"
      },
      {
        "from": "hermes-plugin/business-shell/skills/business-bootstrap/SKILL.md",
        "to": "business-bootstrap/business-bootstrap.SKILL.md"
      },
      {
        "from": "hermes-plugin/business-partner/SKILL.md",
        "to": "business-bootstrap/business-partner.SKILL.md"
      },
      {
        "from": "hermes-plugin/business-whatsapp-policy",
        "to": "business-bootstrap/whatsapp-policy",
        "filter": [
          "__init__.py",
          "policy.py",
          "ingest.py",
          "contract.py",
          "surface.py",
          "guards.py",
          "transport.py",
          "registry.py",
          "plugin.yaml"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "העוזר לעסק"
    }
  }
}
