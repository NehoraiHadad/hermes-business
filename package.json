{
  "name": "hermes-business",
  "version": "0.4.0-alpha.8",
  "private": true,
  "description": "A friendly always-available business assistant powered by Hermes Agent",
  "author": {
    "name": "תכל'ס (Alpha)"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "checksums": "node scripts/gen-installer-checksums.mjs",
    "gen:acceptance": "node scripts/gen-release-acceptance.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "verify:plugin": "node scripts/build-plugin.mjs --check && node --check hermes-plugin/business-shell/plugin.js && node scripts/verify-plugin.mjs",
    "verify:plugin:release": "node scripts/build-plugin.mjs --check && node --check hermes-plugin/business-shell/plugin.js && node scripts/verify-plugin.mjs --release",
    "gen:hermes-contract": "node scripts/gen-hermes-contract.mjs",
    "verify:bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bootstrap.ps1",
    "generate:icons": "python scripts/generate-icons.py",
    "install:plugin": "node scripts/build-plugin.mjs && node scripts/install-plugin.mjs",
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "doctor:environment": "node scripts/environment-doctor.mjs",
    "repair:environment": "node scripts/environment-doctor.mjs --apply",
    "build": "node scripts/build-plugin.mjs && node scripts/verify-plugin.mjs && tsc -b && vite build",
    "build:qa": "node scripts/build-plugin.mjs && node scripts/verify-plugin.mjs && tsc -b && vite build --mode qa",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude scripts/lib/evidence.test.mjs --exclude scripts/lib/evidence-subject.test.mjs",
    "test:components": "vitest run src/components src/hooks src/test src/App.test.tsx",
    "test:evidence": "vitest run scripts/lib/evidence.test.mjs scripts/lib/evidence-subject.test.mjs",
    "test:contract": "npm run test:plugin:policy && npm run test:plugin:community && npm run verify:plugin && npm run verify:bootstrap",
    "test:plugin:policy": "python -m unittest discover -s hermes-plugin/business-whatsapp-policy/tests -p test_*.py -v && python -m unittest discover -s hermes-plugin/business-shell/dashboard -p test_*.py -v",
    "test:plugin:community": "python -B -m unittest discover -s hermes-plugin/community-archive/tests -p test_*.py -v",
    "test:e2e:hermes": "node scripts/e2e-hermes.mjs",
    "test:e2e:hermes-shared-state": "node scripts/e2e-hermes-shared-state.mjs",
    "test:e2e:whatsapp": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-whatsapp-onboarding.ps1",
    "test:e2e:installed-whatsapp-ui": "node scripts/e2e-installed-whatsapp-ui.mjs",
    "test:e2e:installed-attachment-ui": "node scripts/e2e-installed-attachment-ui.mjs",
    "test:e2e:installed-ui": "node scripts/e2e-installed-ui.mjs",
    "attest:test-packaged": "node scripts/gen-build-attestation.mjs",
    "build:test-packaged": "npm run build && node scripts/gen-build-attestation.mjs && electron-builder --win dir",
    "test:e2e:installed-isolated": "node scripts/e2e-installed-isolated.mjs",
    "test:e2e:installed-update": "node scripts/e2e-installed-update.mjs",
    "test:e2e:installed-partner-ui": "node scripts/e2e-installed-partner-ui.mjs",
    "test:e2e:bootstrap-clean": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-bootstrap-clean.ps1",
    "test:e2e:bootstrap-companion": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-companion-bootstrap.ps1",
    "test:e2e:thin-installer": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-thin-network-installer.ps1",
    "test:e2e:nsis-contract": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-companion-nsis-contract.ps1",
    "package:thin-installer:qa": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-thin-network-installer.ps1 -EmitQaArtifact",
    "test:e2e:missing-hermes-ui": "node scripts/e2e-missing-hermes-ui.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify:release": "npm test && npm run test:evidence && npm run test:plugin:policy && npm run test:plugin:community && npm run verify:plugin:release && npm run verify:bootstrap",
    "verify:release-contract": "node scripts/verify-release-contract.mjs",
    "verify:release-contract:qa": "node scripts/verify-release-contract.mjs --channel qa",
    "verify:release-contract:pilot": "node scripts/verify-release-contract.mjs --channel pilot",
    "test:e2e:real-loader": "node scripts/e2e-real-loader.mjs",
    "package:win": "node scripts/package-win.mjs --channel public",
    "package:win:qa": "node scripts/package-win.mjs --channel qa",
    "package:win:pilot": "node scripts/package-win.mjs --channel pilot",
    "finalize:payload": "node scripts/finalize-payload.mjs",
    "test:e2e:exact-artifact": "node scripts/e2e-exact-artifact.mjs",
    "gen:lock-attest": "node scripts/gen-lock-attest.mjs",
    "gen:release-report": "node scripts/gen-release-report.mjs",
    "finalize:release": "node scripts/finalize-release.mjs",
    "package:bootstrap": "npm run build:plugin && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-bootstrap.ps1"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.0",
    "jsdom": "^27.4.0",
    "playwright-core": "^1.54.1",
    "rcedit": "^5.0.2",
    "rollup": "4.62.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "4.1.10"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.hermes.business",
    "productName": "תכל'ס",
    "asar": true,
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "hermes-plugin/**/*",
      "package.json",
      "!hermes-plugin/**/tests/**",
      "!hermes-plugin/**/test_*.py",
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/.pytest_cache/**",
      "!**/.vite/**",
      "!**/.vitest/**",
      "!**/*.test.{cjs,mjs,js,jsx,ts,tsx,py}"
    ],
    "extraResources": [
      {
        "from": "build/build-attestation.json",
        "to": "build-attestation.json"
      },
      {
        "from": "installer/bootstrap.ps1",
        "to": "business-bootstrap/bootstrap.ps1"
      },
      {
        "from": "installer/bootstrap-companion.ps1",
        "to": "business-bootstrap/bootstrap-companion.ps1"
      },
      {
        "from": "installer/lib",
        "to": "business-bootstrap/lib",
        "filter": [
          "*.ps1",
          "enable_plugin.py"
        ]
      },
      {
        "from": "hermes-plugin/business-shell/plugin.js",
        "to": "business-bootstrap/plugin.js"
      },
      {
        "from": "hermes-plugin/business-shell/dashboard",
        "to": "business-bootstrap/dashboard",
        "filter": [
          "manifest.json",
          "plugin_api.py"
        ]
      },
      {
        "from": "hermes-plugin/business-shell/skills/business-bootstrap/SKILL.md",
        "to": "business-bootstrap/business-bootstrap.SKILL.md"
      },
      {
        "from": "hermes-plugin/business-shell/skills/tachles-welcome/SKILL.md",
        "to": "business-bootstrap/tachles-welcome.SKILL.md"
      },
      {
        "from": "hermes-plugin/business-partner/SKILL.md",
        "to": "business-bootstrap/business-partner.SKILL.md"
      },
      {
        "from": "hermes-plugin/business-whatsapp-policy",
        "to": "business-bootstrap/whatsapp-policy",
        "filter": [
          "__init__.py",
          "policy.py",
          "ingest.py",
          "contract.py",
          "surface.py",
          "guards.py",
          "transport.py",
          "registry.py",
          "guard_core.py",
          "surface_core.py",
          "dispatch.py",
          "families.py",
          "egress.py",
          "tool_hook.py",
          "tool_transport.py",
          "tool_contract.py",
          "guard_status.py",
          "plugin.yaml"
        ]
      },
      {
        "from": "scripts/community-generate.mjs",
        "to": "business-bootstrap/community/scripts/community-generate.mjs"
      },
      {
        "from": "scripts/community-provision.mjs",
        "to": "business-bootstrap/community/scripts/community-provision.mjs"
      },
      {
        "from": "scripts/lib/community",
        "to": "business-bootstrap/community/scripts/lib/community",
        "filter": [
          "*.mjs",
          "!*.test.mjs"
        ]
      },
      {
        "from": "assets/community-skills",
        "to": "business-bootstrap/community/assets/community-skills",
        "filter": [
          "**/SKILL.md"
        ]
      },
      {
        "from": "hermes-plugin/community-archive",
        "to": "business-bootstrap/community/hermes-plugin/community-archive",
        "filter": [
          "*.py",
          "plugin.yaml"
        ]
      },
      {
        "from": "node_modules/js-yaml",
        "to": "business-bootstrap/community/node_modules/js-yaml",
        "filter": [
          "index.js",
          "package.json",
          "lib/**/*",
          "dist/**/*"
        ]
      },
      {
        "from": "node_modules/argparse",
        "to": "business-bootstrap/community/node_modules/argparse",
        "filter": [
          "argparse.js",
          "package.json",
          "lib/**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "artifactName": "Tachles-Setup-${version}.exe",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "תכל'ס"
    }
  }
}
