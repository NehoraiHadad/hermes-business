{
  "name": "hermes-business",
  "version": "0.3.2",
  "private": true,
  "description": "A friendly always-available business assistant powered by Hermes Agent",
  "author": "Hermes Business POC",
  "main": "electron/main.cjs",
  "scripts": {
    "verify:plugin": "node --check hermes-plugin/business-shell/plugin.js && node scripts/verify-plugin.mjs",
    "verify:bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-bootstrap.ps1",
    "generate:icons": "python scripts/generate-icons.py",
    "install:plugin": "node scripts/install-plugin.mjs",
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e:hermes": "node scripts/e2e-hermes.mjs",
    "test:e2e:installed-ui": "node scripts/e2e-installed-ui.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-bootstrap.ps1"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.54.1",
    "rcedit": "^5.0.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.hermes.business",
    "productName": "העוזר לעסק",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "hermes-plugin/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "installer/bootstrap.ps1",
        "to": "business-bootstrap/bootstrap.ps1"
      },
      {
        "from": "hermes-plugin/business-shell/plugin.js",
        "to": "business-bootstrap/plugin.js"
      },
      {
        "from": "hermes-plugin/business-shell/skills/business-bootstrap/SKILL.md",
        "to": "business-bootstrap/business-bootstrap.SKILL.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "העוזר לעסק"
    }
  }
}
